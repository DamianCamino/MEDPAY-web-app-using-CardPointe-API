{
  "info": {
    "name": "CardPointe UAT — MedPay & Vital Pay",
    "description": "Sandbox UAT CardPointe.\n\nImportar con `CardPointe-UAT.postman_environment.json`.\n\nFlujo recomendado: Auth → Inquire → Void (misma sesión, antes de batch close).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{api_username}}", "type": "string" },
      { "key": "password", "value": "{{api_password}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Credential Test",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/",
        "description": "Valida credenciales. Respuesta: `CardConnect REST Servlet` (HTTP 200)."
      }
    },
    {
      "name": "2a. Auth — Sale $10 (MedPay)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.retref) pm.environment.set('retref', j.retref);",
              "  pm.test('Approved', () => pm.expect(j.respstat).to.eql('A'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_medpay}}\",\n  \"account\": \"{{test_card}}\",\n  \"expiry\": \"{{test_expiry}}\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"name\": \"Test Patient\",\n  \"capture\": \"y\"\n}"
        },
        "url": "{{base_url}}/auth"
      }
    },
    {
      "name": "2b. Auth — Sale $10 (Vital Pay)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.retref) pm.environment.set('retref', j.retref);",
              "  pm.test('Approved', () => pm.expect(j.respstat).to.eql('A'));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_vitalpay}}\",\n  \"account\": \"{{test_card}}\",\n  \"expiry\": \"{{test_expiry}}\",\n  \"amount\": \"1000\",\n  \"currency\": \"USD\",\n  \"name\": \"Test Patient\",\n  \"capture\": \"y\"\n}"
        },
        "url": "{{base_url}}/auth"
      }
    },
    {
      "name": "3. Auth only — $5 (capture N)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "  const j = pm.response.json();",
              "  if (j.retref) pm.environment.set('retref', j.retref);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_vitalpay}}\",\n  \"account\": \"{{test_card}}\",\n  \"expiry\": \"{{test_expiry}}\",\n  \"amount\": \"500\",\n  \"currency\": \"USD\",\n  \"capture\": \"n\"\n}"
        },
        "url": "{{base_url}}/auth",
        "description": "Auth sin captura. Luego usar **4. Capture** con el retref guardado."
      }
    },
    {
      "name": "4. Capture — by retref",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_vitalpay}}\",\n  \"retref\": \"{{retref}}\",\n  \"amount\": \"500\"\n}"
        },
        "url": "{{base_url}}/capture"
      }
    },
    {
      "name": "5. Inquire — by retref",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/inquire/{{retref}}/{{merchid_vitalpay}}",
        "description": "Ejecutar después de Auth. `retref` se guarda automáticamente si usaste 2a/2b/3."
      }
    },
    {
      "name": "6. Void — by retref",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_vitalpay}}\",\n  \"retref\": \"{{retref}}\"\n}"
        },
        "url": "{{base_url}}/void",
        "description": "Anular antes del batch close. Usar retref de una transacción recién autorizada."
      }
    },
    {
      "name": "7. Refund — by retref",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchid\": \"{{merchid_vitalpay}}\",\n  \"retref\": \"{{retref}}\",\n  \"amount\": \"1000\"\n}"
        },
        "url": "{{base_url}}/refund",
        "description": "Devolución post-settlement. Si Void falla, probar Refund."
      }
    }
  ]
}
